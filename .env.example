# Copy this file to .env and replace every production secret before deployment.

# Docker Compose optional service profiles. `local-db` starts the bundled
# PostgreSQL container. `bundled-edge` starts the bundled nginx and cloudflared
# containers. For a remote PostgreSQL server, remove `local-db` and set
# DATABASE_URL to the remote postgresql+psycopg URL. For an external nginx and
# cloudflared deployment, remove `bundled-edge`.
COMPOSE_PROFILES=local-db,bundled-edge
POSTGRES_DB=ticket_pilot
POSTGRES_USER=ticket_pilot
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_UNAVAILABLE_CHECK_INTERVAL_SECONDS=5
APP_HEALTH_MONITOR_INTERVAL_SECONDS=300
# Disk alerts use free space only. Percentage used remains display-only.
APP_HEALTH_DISK_WARNING_FREE_MB=1000
APP_HEALTH_DISK_CRITICAL_FREE_MB=250
APP_HEALTH_DB_LATENCY_WARNING_MS=250
APP_HEALTH_DB_LATENCY_CRITICAL_MS=1000
APP_HEALTH_DB_POOL_WARNING_PERCENT=80
APP_HEALTH_DB_POOL_CRITICAL_PERCENT=95

# FastAPI application settings.
APP_ENV=production
# DEV_BUILD=true shows a yellow DEV badge in the authenticated top bar and
# suppresses Pushover health notifications for dev/test deployments.
DEV_BUILD=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-app-password
# Optional support contact shown on disabled-account login messages and AI Help answers.
ADMIN_CONTACT_EMAIL=admin@example.com
# Optional deployment-wide office destination. Users may override it privately.
NAVIGATION_OFFICE_ADDRESS=
# LOG_LEVEL controls stdout/stderr application-log verbosity. Allowed: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
APP_SESSION_COOKIE_SECURE=true
# Local app session lifetime in hours before users must sign in again.
APP_SESSION_TIMEOUT_HOURS=12
# Optional second authentication gate. Leave false until a matching Cloudflare
# Access self-hosted application is configured for the public hostname.
CLOUDFLARE_ACCESS_REQUIRED=false
# Optional app-managed Cloudflare zone IP Access Rule blocks for repeated local
# app-login failures and unmatched forgot-password emails. The token must be a
# Cloudflare API token with permission to manage zone firewall/IP access rules
# for CLOUDFLARE_ZONE_ID.
CLOUDFLARE_IP_BLOCKING_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_IP_BLOCK_ALLOWLIST=
CLOUDFLARE_AUTO_BLOCK_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCAL_LOCKOUT_MINUTES=15

# Optional account email for managed web users. Welcome emails and password
# reset links use APP_PUBLIC_BASE_URL and the configured mail delivery settings.
# Leave password reset disabled until these are configured. Turnstile is
# optional but recommended for internet-facing reset forms.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_HOURS=24
# Consecutive reset emails that do not resolve to one enabled account before
# the trusted request IP enters local lockout and optional Cloudflare blocking.
PASSWORD_RESET_FAILED_ATTEMPTS_BLOCK_THRESHOLD=3
APP_PUBLIC_BASE_URL=https://ticketpilot.example.com
MAIL_ENABLED=false
MAIL_FROM_EMAIL=ticketpilot@example.com
MAIL_FROM_NAME=TicketPilot
MAIL_MODE=smtp
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_SMTP_TIMEOUT_SECONDS=10
MAIL_SMTP2GO_API_KEY=
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=10

# Optional best-effort Pushover admin alerts for degraded app health and recovery.
# The app can notify only while this process is running; use an external monitor
# against /health/live for host/container-down alerts.
PUSHOVER_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_APP_KEY=
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json
PUSHOVER_TIMEOUT_SECONDS=10
# Repeat an unchanged degraded-health alert every hour until recovery.
PUSHOVER_REMINDER_INTERVAL_SECONDS=3600

# Passkey/WebAuthn settings. For Cloudflare Tunnel production, set
# WEBAUTHN_ORIGIN to the public HTTPS origin users see in the browser.
WEBAUTHN_RP_NAME=TicketPilot
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Nginx reverse proxy settings. Cloudflare Tunnel should route to Nginx, not directly to FastAPI.
# In Compose, HTTP_PORT is the localhost Nginx port used by the bundled
# host-networked cloudflared connector, for example http://127.0.0.1:11030.
# In Swarm, it is the private Nginx overlay listener port and must match the
# remotely managed tunnel origin, such as http://tpnginx:11030.
HTTP_PORT=11030
NGINX_CLIENT_MAX_BODY_SIZE=12m
# Applies only to authenticated /diagnostics/restore uploads.
NGINX_RESTORE_MAX_BODY_SIZE=250m

# Cloudflare Tunnel settings. The token is a secret from the Zero Trust dashboard.
# CLOUDFLARE_TUNNEL_TOKEN is required when the bundled-edge Compose profile or
# Swarm bundled edge replicas include cloudflared. If missing, the connector
# loops with "Provided Tunnel token is not valid." in cloudflared logs and
# public requests fail with 502.
CLOUDFLARE_TUNNEL_TOKEN=

# Speech-to-text settings. Use "faster_whisper" for local transcription,
# "faster_whisper_remote" for a trusted remote faster-whisper API, "mock" for
# local testing, or "disabled".
TRANSCRIPTION_PROVIDER=faster_whisper
MAX_AUDIO_UPLOAD_BYTES=10485760
# App-side maximum full backup restore upload size, in bytes.
MAX_BACKUP_RESTORE_BYTES=262144000
# Automatic hourly full-database backups are written under /data/backups in
# Docker by default and retained as 6 hourly plus 3 daily files.
AUTOMATIC_BACKUPS_ENABLED=true
AUTOMATIC_BACKUP_DIR=/data/backups
FASTER_WHISPER_MODEL=base.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_DOWNLOAD_ROOT=/models/faster-whisper
FASTER_WHISPER_LOCAL_FILES_ONLY=false
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_CPU_THREADS=8
FASTER_WHISPER_MEMORY_LIMIT=8g
# Set blank to disable the punctuation-formatting prompt.
FASTER_WHISPER_INITIAL_PROMPT=Use normal written punctuation. When spoken punctuation words such as comma, period, question mark, exclamation point, colon, semicolon, dash, or new paragraph are heard, render punctuation marks and paragraph breaks instead of spelling those words.
# Required only when TRANSCRIPTION_PROVIDER=faster_whisper_remote. HTTP remote
# URLs must stay on loopback/private network hosts; public endpoints must use HTTPS.
FASTER_WHISPER_REMOTE_URL=
FASTER_WHISPER_REMOTE_API_KEY=
FASTER_WHISPER_REMOTE_TIMEOUT_SECONDS=120

# AI summary cleanup settings. Set AI_CLEANUP_ENABLED=true only after you are
# comfortable sending summary text to the selected provider.
AI_CLEANUP_ENABLED=false
# Supported values: gemini, grok, ollama, or lm_studio.
# "grok" uses GroqCloud's API. "ollama" and "lm_studio" are queried
# server-side and must point at loopback, Docker host alias, or private LAN URLs.
AI_CLEANUP_PROVIDER=gemini
AI_CLEANUP_TIMEOUT_SECONDS=20
AI_CLEANUP_MAX_INPUT_CHARS=12000
# Pre-cleanup notes kept for Revert cleanup are cleared after this many hours.
AI_CLEANUP_REVERT_RETENTION_HOURS=24
AI_CLEANUP_INSTRUCTIONS=Clean up MSP work-summary notes for an Autotask time entry. Preserve the technical facts, customer impact, ticket context, and any leading Remote or On-Site prefix. Improve grammar, punctuation, capitalization, and readability. Do not invent work, parts, durations, ticket numbers, root causes, customer approvals, or follow-up actions. Return only the cleaned summary text with no markdown, title, explanation, or surrounding quotes.
# Gemini API settings shared by AI Help and Gemini cleanup.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_CLEANUP_MODEL=gemini-3.5-flash
# GroqCloud free/start plan API settings. GROK_API_KEY is also accepted as a
# compatibility fallback, but GROQ_API_KEY matches Groq's official docs.
GROQ_API_KEY=
GROQ_CLEANUP_MODEL=llama-3.1-8b-instant
GROQ_CLEANUP_API_BASE_URL=https://api.groq.com/openai/v1
# Optional compatibility spelling for the requested "grok" provider value:
# GROK_API_KEY=
# GROK_CLEANUP_MODEL=
# GROK_CLEANUP_API_BASE_URL=
# Local Ollama cleanup. The Docker Compose default points at the host machine.
# Use http://127.0.0.1:11434/api only when the app itself is not containerized,
# or use a private LAN base URL such as http://172.25.1.99:11434/api.
# Public URLs are rejected.
OLLAMA_CLEANUP_MODEL=llama3.1
OLLAMA_CLEANUP_API_BASE_URL=http://host.docker.internal:11434/api
# Local LM Studio cleanup through its OpenAI-compatible server. Set the model
# value to the identifier shown by LM Studio for the loaded model. Use a private
# LAN base URL such as http://172.25.1.99:1234/v1 when LM Studio runs elsewhere.
# Public URLs are rejected.
LM_STUDIO_CLEANUP_MODEL=local-model
LM_STUDIO_CLEANUP_API_BASE_URL=http://host.docker.internal:1234/v1
# Optional only if the local LM Studio server requires an API key.
LM_STUDIO_API_KEY=

# AI Help settings. The Help page is visible to authenticated users even while
# this is disabled. AI Help uses the shared Gemini OpenAI-compatible chat API
# settings above. AI_HELP_INSTRUCTIONS is the server-side support prompt sent
# before the user's help question.
AI_HELP_ENABLED=false
AI_HELP_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
AI_HELP_MAX_TOKENS=800
AI_HELP_TEMPERATURE=0.2
AI_HELP_INSTRUCTIONS=

# Autotask settings. Production requires "autotask"; "mock" is only for tests or isolated development.
# Autotask resource IDs are configured per managed web user in the /users page.
AUTOTASK_PROVIDER=autotask
AUTOTASK_BASE_URL=https://webservices.example.autotask.net/ATServicesRest/V1.0
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_API_INTEGRATION_CODE=
AUTOTASK_TIME_ENTRY_TYPE=2
# Caps concurrent live Autotask REST calls below the tenant thread threshold.
# Allowed: 1, 2, or 3. The default leaves one thread of headroom.
AUTOTASK_MAX_CONCURRENT_REQUESTS=2
AUTOTASK_REQUEST_SLOT_TIMEOUT_SECONDS=30

# Optional. Leave false when the API user can create/edit TimeEntries but cannot update Tickets.status.

# Autotask ticket status picklist IDs vary by Autotask tenant. They are needed only when ticket status updates are enabled.
AUTOTASK_STATUS_IN_PROGRESS_ID=
AUTOTASK_STATUS_WAITING_CUSTOMER_ID=
AUTOTASK_STATUS_WAITING_PARTS_ID=
AUTOTASK_STATUS_FOLLOW_UP_ID=
AUTOTASK_STATUS_COMPLETE_ID=

# Production Docker Swarm settings used by docker-stack.yml. Main publishes
# `latest`, the app version, and commit-SHA tags; production should pin the app
# version. Deploy from a GHCR-authenticated manager with --with-registry-auth,
# or configure private registry credentials in Portainer.
TICKET_PILOT_APP_IMAGE=ghcr.io/cosmicc/ticket-pilot-app:2.0.0
TICKET_PILOT_NGINX_IMAGE=ghcr.io/cosmicc/ticket-pilot-nginx:2.0.0
TICKET_PILOT_SWARM_STORAGE_PATH=/mnt/swarm-storage/ticket-pilot

# In the separate docker-stack.dev.yml environment, override the three values
# above with the dev tag and dev NFS root:
# TICKET_PILOT_APP_IMAGE=ghcr.io/cosmicc/ticket-pilot-app:dev
# TICKET_PILOT_NGINX_IMAGE=ghcr.io/cosmicc/ticket-pilot-nginx:dev
# TICKET_PILOT_SWARM_STORAGE_PATH=/mnt/swarm-storage/ticket-pilot-dev
# Both NFS roots must already exist on every node. Swarm uses them only for
# automatic database backups and the faster-whisper model cache.
# App, Nginx, and cloudflared operational logs go only to stdout/stderr.
CLOUDFLARED_LOG_LEVEL=info
